<Window x:Class="ChatOutLoud.TtsProviderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Manage TTS Providers"
        Width="620"
        Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#080C18"
        FontFamily="Segoe UI"
        Foreground="#F4F7FF">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="PanelStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#10172A"/>
            <Setter Property="BorderBrush"
                    Value="#263653"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="18"/>
        </Style>

        <Style x:Key="ProviderCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#0B1222"/>
            <Setter Property="BorderBrush"
                    Value="#314766"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="NormalButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#18243B"/>
            <Setter Property="Foreground"
                    Value="#F4F7FF"/>
            <Setter Property="BorderBrush"
                    Value="#314766"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="16,9"/>
            <Setter Property="MinHeight"
                    Value="36"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#55D9FF"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.70"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource NormalButton}">
            <Setter Property="Background"
                    Value="#6C45FF"/>
            <Setter Property="BorderBrush"
                    Value="#8B70FF"/>
        </Style>

        <!-- DARK SCROLLBAR -->
        <Style x:Key="ScrollRepeatButton"
               TargetType="RepeatButton">

            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="IsTabStop"
                    Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="ScrollThumb"
               TargetType="Thumb">

            <Setter Property="Background"
                    Value="#344868"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">

                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#496083"/>
                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#55D9FF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate"
                         TargetType="ScrollBar">

            <Grid Width="12"
                  Background="Transparent">

                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       IsDirectionReversed="True">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageUpCommand}"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}"
                               MinHeight="24"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageDownCommand}"/>
                    </Track.IncreaseRepeatButton>

                </Track>

            </Grid>

        </ControlTemplate>

        <Style TargetType="ScrollBar">

            <Setter Property="Background"
                    Value="#080C18"/>

            <Style.Triggers>

                <Trigger Property="Orientation"
                         Value="Vertical">

                    <Setter Property="Width"
                            Value="12"/>

                    <Setter Property="Template"
                            Value="{StaticResource VerticalScrollBarTemplate}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Border Background="#080C18"
            CornerRadius="16"
            Margin="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0"
                  Background="#0B1020">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#55D9FF"
                             Margin="0,0,9,0"/>

                    <TextBlock Text="Chat Out Loud"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="   Manage TTS Providers"
                               Foreground="#7787A4"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="×"
                        Width="38"
                        Height="30"
                        Padding="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource NormalButton}"
                        Background="#351826"
                        BorderBrush="#792E45"
                        IsCancel="True"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            </Grid>

            <!-- MAIN PANEL -->
            <Border x:Name="ProviderListView"
                    Grid.Row="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TEXT-TO-SPEECH PROVIDERS"
                               Foreground="#55D9FF"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Text="Connect and manage voice providers available to Chat Out Loud."
                               Foreground="#AAB5CA"
                               Margin="0,5,0,14"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- WINDOWS -->
                            <Border Style="{StaticResource ProviderCardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Windows Voices"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Voices installed on this computer"
                                                   Foreground="#AAB5CA"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#55D9FF"
                                                 Margin="0,0,7,0"/>

                                        <TextBlock Text="Built in"
                                                   Foreground="#AAB5CA"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- ELEVENLABS -->
                            <Border Style="{StaticResource ProviderCardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="ElevenLabs"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Cloud text-to-speech voices"
                                                   Foreground="#AAB5CA"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <TextBlock x:Name="ElevenLabsStatusText"
                                               Grid.Column="1"
                                               Text="Not configured"
                                               Foreground="#7787A4"
                                               Margin="15,0"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="ElevenLabsConfigureButton"
                                            Grid.Column="2"
                                            Content="Configure"
                                            Width="100"
                                            Style="{StaticResource NormalButton}"
                                            Click="ElevenLabsConfigureButton_Click"/>

                                </Grid>

                            </Border>

                            <!-- GOOGLE CLOUD -->
                            <Border Style="{StaticResource ProviderCardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Google Cloud TTS"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Google Cloud text-to-speech voices"
                                                   Foreground="#AAB5CA"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <TextBlock x:Name="GoogleStatusText"
                                               Grid.Column="1"
                                               Text="Not configured"
                                               Foreground="#7787A4"
                                               Margin="15,0"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="GoogleConfigureButton"
                                            Grid.Column="2"
                                            Content="Configure"
                                            Width="100"
                                            Style="{StaticResource NormalButton}"
                                            Click="GoogleConfigureButton_Click"/>

                                </Grid>

                            </Border>

                            <!-- AZURE -->
                            <Border Style="{StaticResource ProviderCardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Microsoft Azure Speech"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Microsoft cloud speech voices"
                                                   Foreground="#AAB5CA"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <TextBlock x:Name="AzureStatusText"
                                               Grid.Column="1"
                                               Text="Not configured"
                                               Foreground="#7787A4"
                                               Margin="15,0"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="AzureConfigureButton"
                                            Grid.Column="2"
                                            Content="Configure"
                                            Width="100"
                                            Style="{StaticResource NormalButton}"
                                            Click="AzureConfigureButton_Click"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- GOOGLE CLOUD SETUP -->
            <Border x:Name="GoogleSetupView"
                    Grid.Row="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="14"
                    Visibility="Collapsed">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="GoogleBackButton"
                            Grid.Row="0"
                            Content="← Back"
                            Width="90"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NormalButton}"
                            Click="GoogleBackButton_Click"/>

                    <TextBlock Grid.Row="1"
                               Text="GOOGLE CLOUD TEXT-TO-SPEECH"
                               Foreground="#55D9FF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,16,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="Connect a Google Cloud service-account credential to make Google voices available in Chat Out Loud."
                               Foreground="#AAB5CA"
                               TextWrapping="Wrap"
                               Margin="0,5,0,16"/>

                    <StackPanel Grid.Row="3">

                        <TextBlock Text="Credentials File"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="38"
                                    Background="#0B1222"
                                    BorderBrush="#314766"
                                    BorderThickness="1"
                                    CornerRadius="9">

                                <TextBox x:Name="GoogleCredentialPathTextBox"
                                         Padding="10,7"
                                         Background="Transparent"
                                         Foreground="#F4F7FF"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>

                            </Border>

                            <Button x:Name="GoogleChooseCredentialButton"
                                    Grid.Column="1"
                                    Content="Choose File"
                                    Width="110"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource NormalButton}"
                                    Click="GoogleChooseCredentialButton_Click"/>

                        </Grid>

                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="#0B1222"
                            BorderBrush="#314766"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,16,0,0">

                        <StackPanel>

                            <TextBlock Text="Connection Status"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="GoogleSetupStatusText"
                                       Text="Not configured"
                                       Foreground="#7787A4"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                Margin="0,16,0,0">

                        <Button x:Name="GoogleVerifyButton"
                                Content="Verify Connection"
                                Width="150"
                                Style="{StaticResource AccentButton}"
                                Click="GoogleVerifyButton_Click"/>

                        <Button x:Name="GoogleRemoveButton"
                                Content="Remove Connection"
                                Width="155"
                                Margin="10,0,0,0"
                                Style="{StaticResource NormalButton}"
                                Click="GoogleRemoveButton_Click"/>

                    </StackPanel>

                    <Button x:Name="GoogleHelpButton"
                            Grid.Row="6"
                            Content="?  How to connect Google Cloud"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="0,16,0,0"
                            Style="{StaticResource NormalButton}"
                            Click="GoogleHelpButton_Click"/>

                </Grid>

            </Border>

            <!-- ELEVENLABS SETUP -->
            <Border x:Name="ElevenLabsSetupView"
                    Grid.Row="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="14"
                    Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="ElevenLabsBackButton"
                            Grid.Row="0"
                            Content="← Back"
                            Width="90"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NormalButton}"
                            Click="ElevenLabsBackButton_Click"/>

                    <TextBlock Grid.Row="1"
                               Text="ELEVENLABS"
                               Foreground="#55D9FF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,16,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="Connect your ElevenLabs API key to make compatible ElevenLabs voices available in Chat Out Loud."
                               Foreground="#AAB5CA"
                               TextWrapping="Wrap"
                               Margin="0,5,0,16"/>

                    <StackPanel Grid.Row="3">

                        <TextBlock Text="API Key"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <Border Height="38"
                                Background="#0B1222"
                                BorderBrush="#314766"
                                BorderThickness="1"
                                CornerRadius="9">

                            <PasswordBox x:Name="ElevenLabsApiKeyPasswordBox"
                                         Padding="10,7"
                                         Background="Transparent"
                                         Foreground="#F4F7FF"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <Border Grid.Row="5"
                            Background="#0B1222"
                            BorderBrush="#314766"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,16,0,0">

                        <StackPanel>

                            <TextBlock Text="Connection Status"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ElevenLabsSetupStatusText"
                                       Text="Not configured"
                                       Foreground="#7787A4"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                Margin="0,16,0,0">

                        <Button x:Name="ElevenLabsVerifyButton"
                                Content="Verify Connection"
                                Width="150"
                                Style="{StaticResource AccentButton}"
                                Click="ElevenLabsVerifyButton_Click"/>

                        <Button x:Name="ElevenLabsRemoveButton"
                                Content="Remove Connection"
                                Width="155"
                                Margin="10,0,0,0"
                                Style="{StaticResource NormalButton}"
                                Click="ElevenLabsRemoveButton_Click"/>

                    </StackPanel>

                    <Button x:Name="ElevenLabsHelpButton"
                            Grid.Row="7"
                            Content="?  How to connect ElevenLabs"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="0,16,0,0"
                            Style="{StaticResource NormalButton}"
                            Click="ElevenLabsHelpButton_Click"/>

                    </Grid>

                </ScrollViewer>

            </Border>

            <!-- MICROSOFT AZURE SPEECH SETUP -->
            <Border x:Name="AzureSetupView"
                    Grid.Row="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="14"
                    Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="AzureBackButton"
                                Grid.Row="0"
                                Content="← Back"
                                Width="90"
                                HorizontalAlignment="Left"
                                Style="{StaticResource NormalButton}"
                                Click="AzureBackButton_Click"/>

                        <TextBlock Grid.Row="1"
                                   Text="MICROSOFT AZURE SPEECH"
                                   Foreground="#55D9FF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Text="Connect your Microsoft Azure Speech resource to make compatible Azure voices available in Chat Out Loud."
                                   Foreground="#AAB5CA"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,16"/>

                        <StackPanel Grid.Row="3">

                            <TextBlock Text="Speech Resource Key"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Border Height="38"
                                    Background="#0B1222"
                                    BorderBrush="#314766"
                                    BorderThickness="1"
                                    CornerRadius="9">

                                <PasswordBox x:Name="AzureSpeechKeyPasswordBox"
                                             Padding="10,7"
                                             Background="Transparent"
                                             Foreground="#F4F7FF"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"/>

                            </Border>

                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Margin="0,16,0,0">

                            <TextBlock Text="Region"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Border Height="38"
                                    Background="#0B1222"
                                    BorderBrush="#314766"
                                    BorderThickness="1"
                                    CornerRadius="9">

                                <TextBox x:Name="AzureRegionTextBox"
                                         Padding="10,7"
                                         Background="Transparent"
                                         Foreground="#F4F7FF"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"/>

                            </Border>

                        </StackPanel>

                        <Border Grid.Row="5"
                                Background="#0B1222"
                                BorderBrush="#314766"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,16,0,0">

                            <StackPanel>

                                <TextBlock Text="Connection Status"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="AzureSetupStatusText"
                                           Text="Not configured"
                                           Foreground="#7787A4"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <StackPanel Grid.Row="6"
                                    Orientation="Horizontal"
                                    Margin="0,16,0,0">

                            <Button x:Name="AzureVerifyButton"
                                    Content="Verify Connection"
                                    Width="150"
                                    Style="{StaticResource AccentButton}"
                                    Click="AzureVerifyButton_Click"/>

                            <Button x:Name="AzureRemoveButton"
                                    Content="Remove Connection"
                                    Width="155"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource NormalButton}"
                                    Click="AzureRemoveButton_Click"/>

                        </StackPanel>

                        <Button x:Name="AzureHelpButton"
                                Grid.Row="7"
                                Content="?  How to connect Microsoft Azure"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0"
                                Style="{StaticResource NormalButton}"
                                Click="AzureHelpButton_Click"/>

                    </Grid>

                </ScrollViewer>

            </Border>

            <Border Grid.RowSpan="2"
                    Margin="2"
                    BorderBrush="#314766"
                    BorderThickness="1"
                    CornerRadius="14"
                    IsHitTestVisible="False"/>

        </Grid>

    </Border>

</Window>