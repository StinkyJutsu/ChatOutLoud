<Window x:Class="ChatOutLoud.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Chat Out Loud"
        Width="1100"
        Height="720"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080C18"
        FontFamily="Segoe UI"
        Foreground="#F4F7FF">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- PANELS -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#10172A"/>
            <Setter Property="BorderBrush" Value="#263653"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- SECTION HELP BUTTON -->
        <Style x:Key="SectionHelpButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#AAB5CA"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Opacity"
                    Value="0.82"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Grid Background="Transparent">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Border Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#0B1222"
                                        BorderBrush="#55D9FF"
                                        BorderThickness="1">

                                    <TextBlock Text="?"
                                               Foreground="#55D9FF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <ContentPresenter Margin="6,0,0,0"
                                                  VerticalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="1"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Opacity"
                                        Value="0.60"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- BUTTONS -->
        <Style x:Key="NormalButton" TargetType="Button">
            <Setter Property="Background" Value="#18243B"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderBrush" Value="#314766"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#55D9FF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.70"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource NormalButton}">
            <Setter Property="Background" Value="#6C45FF"/>
            <Setter Property="BorderBrush" Value="#8B70FF"/>
        </Style>

        <Style x:Key="RunButton"
               TargetType="Button"
               BasedOn="{StaticResource NormalButton}">
            <Setter Property="Background" Value="#168A58"/>
            <Setter Property="BorderBrush" Value="#24C97B"/>
        </Style>

        <Style x:Key="StopButton"
               TargetType="Button"
               BasedOn="{StaticResource NormalButton}">
            <Setter Property="Background" Value="#792E45"/>
            <Setter Property="BorderBrush" Value="#C74A69"/>
        </Style>

        <Style x:Key="TitleBarButton"
               TargetType="Button"
               BasedOn="{StaticResource NormalButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- TEXT BOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1222"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderBrush" Value="#314766"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#55D9FF"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                        <ScrollViewer x:Name="PART_ContentHost"
                                    Background="Transparent"
                                    Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#55D9FF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- LIST BOX -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0B1222"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderBrush" Value="#314766"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ListBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer Margin="0,5,4,5"
                                          Background="Transparent"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">

                                <ItemsPresenter/>

                            </ScrollViewer>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18243B"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#342B68"/>
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                    </MultiTrigger.Conditions>

                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- COMBO BOX -->
        <Style x:Key="ComboToggleButton"
               TargetType="ToggleButton">

            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="ComboBox">

            <Setter Property="Background" Value="#0B1222"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderBrush" Value="#314766"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="MinHeight" Value="36"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="10,0,6,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>

                                    <Border Grid.Column="1"
                                            BorderBrush="#314766"
                                            BorderThickness="1,0,0,0">

                                        <ToggleButton Style="{StaticResource ComboToggleButton}"
                                                      IsChecked="{Binding IsDropDownOpen,
                                                                          RelativeSource={RelativeSource TemplatedParent},
                                                                          Mode=TwoWay}">

                                            <Path Data="M 0 0 L 5 5 L 10 0"
                                                  Stroke="#55D9FF"
                                                  StrokeThickness="2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                        </ToggleButton>

                                    </Border>

                                </Grid>

                            </Border>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True">

                                <Border Background="#10172A"
                                        BorderBrush="#314766"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        Width="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="220"
                                                  Background="Transparent"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#10172A"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="2">

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="#182640"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ComboItemBorder"
                                        Property="Background"
                                        Value="#16324A"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- CHECK BOX -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE6F7"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <!-- SLIDERS -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">

                        <Grid Height="20">

                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="White"
                                                  BorderThickness="0"
                                                  Height="2"
                                                  VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14"
                                           Background="#344868">

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">

                                                <Border x:Name="SliderThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="SliderThumbBorder"
                                                                Property="Background"
                                                                Value="#496083"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">
                                                        <Setter TargetName="SliderThumbBorder"
                                                                Property="Background"
                                                                Value="#55D9FF"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="White"
                                                  BorderThickness="0"
                                                  Height="2"
                                                  VerticalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- DARK SCROLLBARS -->

        <Style x:Key="ScrollRepeatButton"
               TargetType="RepeatButton">

            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="ScrollThumb"
               TargetType="Thumb">

            <Setter Property="Background" Value="#344868"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">

                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2,0"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#496083"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#55D9FF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- VERTICAL SCROLLBAR -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate"
                         TargetType="ScrollBar">

            <Grid Width="16"
                  Background="Transparent">

                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}"
                       ViewportSize="NaN"
                       IsDirectionReversed="True">

                    <Track.DecreaseRepeatButton>

                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageUpCommand}"/>

                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>

                        <Thumb Style="{StaticResource ScrollThumb}"
                               Height="30"/>

                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>

                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageDownCommand}"/>

                    </Track.IncreaseRepeatButton>

                </Track>

            </Grid>

        </ControlTemplate>

        <!-- HORIZONTAL SCROLLBAR -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                         TargetType="ScrollBar">

            <Grid Height="12"
                  Background="Transparent">

                <Track x:Name="PART_Track"
                       Orientation="Horizontal"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       IsDirectionReversed="False">

                    <Track.DecreaseRepeatButton>

                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}"/>

                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>

                        <Thumb Style="{StaticResource ScrollThumb}"
                               MinWidth="24"/>

                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>

                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                      Command="{x:Static ScrollBar.PageRightCommand}"/>

                    </Track.IncreaseRepeatButton>

                </Track>

            </Grid>

        </ControlTemplate>

        <!-- SCROLLBAR -->
        <Style TargetType="ScrollBar">

            <Setter Property="Background"
                    Value="#080C18"/>

            <Style.Triggers>

                <Trigger Property="Orientation"
                         Value="Vertical">

                    <Setter Property="Width"
                            Value="16"/>

                    <Setter Property="Template"
                            Value="{StaticResource VerticalScrollBarTemplate}"/>

                </Trigger>

                <Trigger Property="Orientation"
                         Value="Horizontal">

                    <Setter Property="Height"
                            Value="12"/>

                    <Setter Property="Template"
                            Value="{StaticResource HorizontalScrollBarTemplate}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- DARK SCROLLVIEWER -->
        <Style TargetType="ScrollViewer">

            <Setter Property="Background"
                    Value="#080C18"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollViewer">

                        <Grid Background="{TemplateBinding Background}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Grid.Row="0"
                                Grid.Column="0"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                Margin="{TemplateBinding Padding}"/>

                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Value="{TemplateBinding VerticalOffset}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                Minimum="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Value="{TemplateBinding HorizontalOffset}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>


                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="Tag"
                                     Value="MainWindowScroll">

                                <Setter TargetName="PART_VerticalScrollBar"
                                        Property="Margin"
                                        Value="0,8,0,8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- OUTER WINDOW -->
    <Border Background="#080C18"
            CornerRadius="16"
            Margin="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0"
                  Background="#0B1020">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#55D9FF"
                             Margin="0,0,9,0"/>

                    <TextBlock Text="Chat Out Loud"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="   Twitch Chat Text-to-Speech"
                               Foreground="#7787A4"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">

                        <Ellipse x:Name="ConnectionStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#FF5A6B"
                                 Margin="0,0,7,0"/>

                        <TextBlock x:Name="ConnectionStatusText"
                                   Text="Not Connected"
                                   Foreground="#AAB5CA"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <Button Content="—"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>

                    <Button Content="□"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"/>

                    <Button Content="×"
                            Style="{StaticResource TitleBarButton}"
                            Background="#351826"
                            BorderBrush="#792E45"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

            <!-- MAIN SCROLL AREA -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="0,0,7,0"
                          Tag="MainWindowScroll">

                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer"
                           BasedOn="{StaticResource {x:Type ScrollViewer}}">

                        <Setter Property="VerticalScrollBarVisibility"
                                Value="Auto"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState,
                                                          RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="Maximized">

                                <Setter Property="VerticalScrollBarVisibility"
                                        Value="Disabled"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </ScrollViewer.Style>

                <Grid Margin="20"
                      MinWidth="1040"
                      MinHeight="620">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MAIN CONTENT -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT -->
                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource PanelStyle}">

                                <StackPanel>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="TWITCH CONNECTION"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Help"
                                                Style="{StaticResource SectionHelpButton}"
                                                VerticalAlignment="Center"
                                                Click="TwitchConnectionHelpButton_Click"/>

                                    </Grid>

                                    <!-- TWITCH ACCOUNT PROFILE -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,14,0,10">

                                        <!-- Profile picture -->
                                        <Ellipse x:Name="TwitchProfileImage"
                                                 Width="48"
                                                 Height="48"
                                                 Fill="#18243B"
                                                 Stroke="#314766"
                                                 StrokeThickness="1"
                                                 VerticalAlignment="Center"/>

                                        <!-- Username / connection state -->
                                        <StackPanel Margin="12,0,0,0"
                                                    VerticalAlignment="Center">

                                            <TextBlock x:Name="TwitchUsernameText"
                                                       Text="No Twitch account authorized"
                                                       Foreground="#F4F7FF"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock x:Name="TwitchConnectionStatusText"
                                                       Text="Not connected"
                                                       Foreground="#7787A4"
                                                       FontSize="12"
                                                       Margin="0,3,0,0"/>

                                        </StackPanel>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <Button x:Name="AuthorizeTwitchButton"
                                                Content="Authorize Twitch"
                                                Style="{StaticResource AccentButton}"
                                                Click="AuthorizeTwitchButton_Click"/>

                                        <Button x:Name="DisconnectTwitchButton"
                                                Content="Disconnect"
                                                Style="{StaticResource NormalButton}"
                                                Click="DisconnectTwitchButton_Click"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,3">

                                <StackPanel>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="SPEECH CONTROL"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Help"
                                                Style="{StaticResource SectionHelpButton}"
                                                VerticalAlignment="Center"
                                                Click="SpeechControlHelpButton_Click"/>

                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,12,0,10">

                                        <Button x:Name="RunButton"
                                                Content="RUN"
                                                Width="110"
                                                Height="42"
                                                Style="{StaticResource RunButton}"
                                                Click="RunButton_Click"/>

                                        <Button x:Name="StopButton"
                                                Content="STOP"
                                                Width="110"
                                                Height="42"
                                                Style="{StaticResource StopButton}"
                                                Click="StopButton_Click"/>

                                        <Button Content="Skip"
                                                Style="{StaticResource NormalButton}"
                                                Click="SkipButton_Click"/>

                                        <Button Content="Clear Queue"
                                                Style="{StaticResource NormalButton}"
                                                Click="ClearQueueButton_Click"/>

                                        <TextBlock x:Name="QueueCountText"
                                                   Text="Queue: 0"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#55D9FF"/>

                                    </StackPanel>

                                    <TextBlock Text="Voice"
                                               Foreground="#AAB5CA"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="VoiceComboBox"
                                                  SelectedIndex="0"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel">

                                            <ComboBox.Resources>

                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background"
                                                            Value="#10172A"/>
                                                    <Setter Property="Foreground"
                                                            Value="#F4F7FF"/>
                                                    <Setter Property="Padding"
                                                            Value="10,8"/>
                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Stretch"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="Transparent"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="1"/>

                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ComboBoxItem">

                                                                <Border x:Name="VoiceItemBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6"
                                                                        Margin="1">

                                                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center"/>

                                                                </Border>

                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                                                             Value="True">
                                                                        <Setter TargetName="VoiceItemBorder"
                                                                                Property="Background"
                                                                                Value="#182640"/>
                                                                    </Trigger>

                                                                    <Trigger Property="IsSelected"
                                                                             Value="True">
                                                                        <Setter TargetName="VoiceItemBorder"
                                                                                Property="Background"
                                                                                Value="#16324A"/>
                                                                        <Setter TargetName="VoiceItemBorder"
                                                                                Property="BorderBrush"
                                                                                Value="#55D9FF"/>
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>



                                            </ComboBox.Resources>

                                            <ComboBox.Template>
                                                <ControlTemplate TargetType="ComboBox">

                                                    <Grid>

                                                        <Border x:Name="VoiceComboBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="38"/>
                                                                </Grid.ColumnDefinitions>

                                                                <ContentPresenter Margin="10,0,6,0"
                                                                                  VerticalAlignment="Center"
                                                                                  Content="{TemplateBinding SelectionBoxItem}"/>

                                                                <Border Grid.Column="1"
                                                                        BorderBrush="#314766"
                                                                        BorderThickness="1,0,0,0">

                                                                    <ToggleButton Style="{StaticResource ComboToggleButton}"
                                                                                  IsChecked="{Binding IsDropDownOpen,
                                                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                                                      Mode=TwoWay}">

                                                                        <Path Data="M 0 0 L 5 5 L 10 0"
                                                                              Stroke="#55D9FF"
                                                                              StrokeThickness="2"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>

                                                                    </ToggleButton>

                                                                </Border>

                                                            </Grid>

                                                        </Border>

                                                        <Popup x:Name="PART_Popup"
                                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               Placement="Bottom"
                                                               AllowsTransparency="True">

                                                            <Border Background="#0B1222"
                                                                    BorderBrush="#314766"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Margin="0,4,0,0"
                                                                    Width="{Binding ActualWidth,
                                                                                  RelativeSource={RelativeSource TemplatedParent}}">

                                                                <Grid Margin="4">

                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBox x:Name="VoiceSearchTextBox"
                                                                             Height="34"
                                                                             Margin="4,4,4,8"
                                                                             Padding="10,0"
                                                                             VerticalContentAlignment="Center"
                                                                             ToolTip="Search voices..."
                                                                             TextChanged="VoiceSearchTextBox_TextChanged"/>

                                                                    <ScrollViewer Grid.Row="1"
                                                                                  MaxHeight="360"
                                                                                  Margin="4,0,4,4"
                                                                                  Background="Transparent"
                                                                                  VerticalScrollBarVisibility="Visible"
                                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                                  CanContentScroll="True"
                                                                                  ScrollChanged="VoiceListScrollViewer_ScrollChanged"
                                                                                  PreviewMouseWheel="VoiceListScrollViewer_PreviewMouseWheel">

                                                                        <ScrollViewer.Resources>

                                                                            <Style TargetType="ScrollBar">
                                                                                <Setter Property="Width"
                                                                                        Value="16"/>

                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>

                                                                                        <ControlTemplate TargetType="ScrollBar">

                                                                                            <Grid Width="16"
                                                                                                  Background="Transparent">

                                                                                                <Track x:Name="PART_Track"
                                                                                                       Orientation="Vertical"
                                                                                                       Minimum="{TemplateBinding Minimum}"
                                                                                                       Maximum="{TemplateBinding Maximum}"
                                                                                                       Value="{TemplateBinding Value}"
                                                                                                       ViewportSize="NaN"
                                                                                                       IsDirectionReversed="True">

                                                                                                    <Track.DecreaseRepeatButton>
                                                                                                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                                                                                                      Command="{x:Static ScrollBar.PageUpCommand}"/>
                                                                                                    </Track.DecreaseRepeatButton>

                                                                                                    <Track.Thumb>
                                                                                                        <Thumb Style="{StaticResource ScrollThumb}"
                                                                                                               Height="30"/>
                                                                                                    </Track.Thumb>

                                                                                                    <Track.IncreaseRepeatButton>
                                                                                                        <RepeatButton Style="{StaticResource ScrollRepeatButton}"
                                                                                                                      Command="{x:Static ScrollBar.PageDownCommand}"/>
                                                                                                    </Track.IncreaseRepeatButton>

                                                                                                </Track>

                                                                                            </Grid>

                                                                                        </ControlTemplate>

                                                                                    </Setter.Value>
                                                                                </Setter>

                                                                            </Style>

                                                                        </ScrollViewer.Resources>

                                                                        <ItemsPresenter/>

                                                                    </ScrollViewer>

                                                                </Grid>

                                                            </Border>

                                                        </Popup>

                                                    </Grid>

                                                </ControlTemplate>
                                            </ComboBox.Template>

                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel IsVirtualizing="True"
                                                                            VirtualizationMode="Recycling"/>
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>

                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem"
                                                       BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                    <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping"
                                                            Value="True"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>

                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                     <Grid>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="#F4F7FF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>

                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#10172A"
                                                                    Padding="10,8,10,5">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#55D9FF"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="11"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>

                                        </ComboBox>

                                        <Button x:Name="RefreshVoicesButton"
                                                Grid.Column="1"
                                                Width="42"
                                                Content="⟳"
                                                Margin="10,0,0,0"
                                                Padding="0"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="16"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource NormalButton}"
                                                Click="RefreshVoicesButton_Click"/>

                                        <Button Grid.Column="2"
                                                Content="Manage TTS Providers"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource NormalButton}"
                                                Click="ManageTtsProvidersButton_Click"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="Volume"
                                                   Foreground="#AAB5CA"/>

                                        <TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="75"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="0"
                                                   HorizontalAlignment="Left"
                                                   Foreground="#7787A4"
                                                   FontSize="11"/>

                                        <TextBlock Text="50"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#7787A4"
                                                   FontSize="11"/>

                                        <TextBlock Text="100"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#7787A4"
                                                   FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="Speech Speed"
                                                   Foreground="#AAB5CA"/>

                                        <TextBlock Text="{Binding ElementName=SpeechSpeedSlider, Path=Value, StringFormat={}{0:+0;-0;0}}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Slider x:Name="SpeechSpeedSlider"
                                            Minimum="-10"
                                            Maximum="10"
                                            Value="0"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="-10"
                                                   HorizontalAlignment="Left"
                                                   Foreground="#7787A4"
                                                   FontSize="11"/>

                                        <TextBlock Text="0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#AAB5CA"
                                                   FontSize="11"/>

                                        <TextBlock Text="+10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#7787A4"
                                                   FontSize="11"/>
                                    </Grid>

                                    <TextBlock Text="Audio Output"
                                               Margin="0,10,0,0"
                                               Foreground="#AAB5CA"/>

                                    <ComboBox x:Name="AudioOutputComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="AudioOutputComboBox_SelectionChanged">

                                        <ComboBox.Resources>

                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background"
                                                        Value="#10172A"/>
                                                <Setter Property="Foreground"
                                                        Value="#F4F7FF"/>
                                                <Setter Property="Padding"
                                                        Value="10,8"/>
                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Stretch"/>
                                                <Setter Property="BorderBrush"
                                                        Value="Transparent"/>
                                                <Setter Property="BorderThickness"
                                                        Value="1"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ComboBoxItem">

                                                            <Border x:Name="AudioOutputItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Margin="1">

                                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="Center"/>

                                                            </Border>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="AudioOutputItemBorder"
                                                                            Property="Background"
                                                                            Value="#182640"/>
                                                                </Trigger>

                                                                <Trigger Property="IsSelected"
                                                                         Value="True">
                                                                    <Setter TargetName="AudioOutputItemBorder"
                                                                            Property="Background"
                                                                            Value="#16324A"/>
                                                                    <Setter TargetName="AudioOutputItemBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#55D9FF"/>
                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                        </ComboBox.Resources>

                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="Refresh Devices"
                                                Style="{StaticResource NormalButton}"
                                                Click="RefreshDevicesButton_Click"/>

                                        <Button Content="Test Voice"
                                                Style="{StaticResource AccentButton}"
                                                Click="TestVoiceButton_Click"/>

                                    </StackPanel>

                                    <CheckBox x:Name="SpeakUsernamesCheckBox"
                                              Content="Speak usernames before messages"
                                              IsChecked="True"/>


                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- RIGHT -->
                        <Grid Grid.Column="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="400"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="400"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource PanelStyle}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="VIEWERS / BOTS"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Help"
                                                Style="{StaticResource SectionHelpButton}"
                                                VerticalAlignment="Center"
                                                Click="ViewersBotsHelpButton_Click"/>

                                    </Grid>

                                    <TextBox x:Name="UserSearchTextBox"
                                             Grid.Row="1"
                                             Margin="0,12,0,8"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"
                                             TextChanged="UserSearchTextBox_TextChanged"/>

                                    <ListBox x:Name="DetectedUsersList"
                                             Grid.Row="2"
                                             SelectionChanged="DetectedUsersList_SelectionChanged"
                                             LostKeyboardFocus="DetectedUsersList_LostKeyboardFocus"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel">

                                        <ListBox.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                             Color="Transparent"/>

                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                                             Color="#F4F7FF"/>
                                        </ListBox.Resources>

                                    </ListBox>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                Margin="0,8,0,0">

                                        <Button Content="Mute"
                                                Style="{StaticResource AccentButton}"
                                                Click="MuteUserButton_Click"/>

                                        <Button Content="Unmute"
                                                Style="{StaticResource NormalButton}"
                                                Click="UnmuteUserButton_Click"/>

                                        <Button Content="Add Manually"
                                                Style="{StaticResource NormalButton}"
                                                Click="AddManualUserButton_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource PanelStyle}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="MUTED WORDS / PHRASES"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Help"
                                                Style="{StaticResource SectionHelpButton}"
                                                VerticalAlignment="Center"
                                                Click="MutedWordsPhrasesHelpButton_Click"/>

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,12,0,8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="MutedPhraseInput"
                                                 Height="36"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap"/>

                                        <Button Grid.Column="1"
                                                Content="Add"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource AccentButton}"
                                                Click="AddMutedPhraseButton_Click"/>

                                    </Grid>

                                    <ListBox x:Name="MutedPhrasesList"
                                             Grid.Row="2"
                                             Margin="0,0,0,8"
                                             SelectionChanged="MutedPhrasesList_SelectionChanged"
                                             LostKeyboardFocus="MutedPhrasesList_LostKeyboardFocus"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"/>

                                    <StackPanel Grid.Row="3">

                                        <StackPanel Orientation="Horizontal">

                                            <Button Content="Remove"
                                                    Style="{StaticResource NormalButton}"
                                                    Click="RemoveMutedPhraseButton_Click"/>

                                            <CheckBox x:Name="MuteLinksCheckBox"
                                                      Content="Mute links"
                                                      Margin="18,0,0,0"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox x:Name="MuteCommandsCheckBox"
                                                      Content="Mute commands"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0">

                                            <CheckBox x:Name="MuteNumbersCheckBox"
                                                      Content="Mute numbers"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox x:Name="MuteSpecialSymbolsCheckBox"
                                                      Content="Mute special symbols"
                                                      Margin="18,0,0,0"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox x:Name="MuteEmotesCheckBox"
                                                      Content="Mute emotes"
                                                      Margin="18,0,0,0"
                                                      VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border Grid.Row="4"
                                    Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,3">

                                <StackPanel>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="CHAT JOIN SOUND"
                                                   Foreground="#55D9FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Help"
                                                Style="{StaticResource SectionHelpButton}"
                                                VerticalAlignment="Center"
                                                Click="ChatJoinSoundHelpButton_Click"/>

                                    </Grid>

                                    <Grid Margin="0,10,0,5">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="105"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="EnableJoinSoundCheckBox"
                                                  Grid.Column="0"
                                                  Content="Enable join sound"
                                                  VerticalAlignment="Center"/>

                                        <CheckBox x:Name="EnableJoinUsernameCheckBox"
                                                  Grid.Column="2"
                                                  Content="Enable username"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="Volume"
                                                   VerticalAlignment="Center"
                                                   Foreground="#AAB5CA"/>

                                        <Slider x:Name="JoinSoundVolumeSlider"
                                                Grid.Column="6"
                                                Width="105"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="100"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="Choose Sound"
                                                Style="{StaticResource NormalButton}"
                                                Click="ChooseJoinSoundButton_Click"/>

                                        <Button Grid.Column="1"
                                                Content="Test"
                                                Style="{StaticResource AccentButton}"
                                                Click="TestJoinSoundButton_Click"/>

                                        <Border Grid.Column="3"
                                                Height="36"
                                                VerticalAlignment="Center"
                                                Background="#0B1222"
                                                BorderBrush="#314766"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,0">

                                            <TextBlock x:Name="JoinSoundFileNameText"
                                                       Text="No sound selected"
                                                       VerticalAlignment="Center"
                                                       Foreground="#AAB5CA"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </Border>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Grid>

                </Grid>

            </ScrollViewer>

            <!-- Rounded window outline drawn above all content -->
            <Border Grid.RowSpan="2"
                    Margin="2"
                    BorderBrush="#314766"
                    BorderThickness="1"
                    CornerRadius="14"
                    IsHitTestVisible="False"/>

        </Grid>

    </Border>

</Window>